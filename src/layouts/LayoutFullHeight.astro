---
import Footer from '../components/layout/Footer.astro';
import HeaderAlt from '../components/layout/HeaderAlt.astro';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

import '../styles/styles.scss';

const siteUrl = 'https://tomdeluca.dev';
const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1622" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" id="site-favicon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tom DeLuca — Senior Front-End Developer" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        if (stored) {
          var favicon = document.getElementById('site-favicon');
          if (favicon) favicon.href = '/favicon-' + theme + '.svg';
        }
      })();
    </script>
  </head>
  <body>
    <HeaderAlt />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script src="../scripts/index.js"></script>
  </body>
</html>
